{
  "name": "colombocal-backend",
  "version": "1.0.0",
  "description": "Backend do sistema Colombocal - Gestão Comercial de Distribuidora de Cal",
  "main": "src/index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "test": "node --test --test-concurrency=1 test/**/*.test.js",
    "test:coverage": "c8 node --test --test-concurrency=1 test/**/*.test.js",
    "test:coverage:check": "c8 --check-coverage node --test --test-concurrency=1 test/**/*.test.js",
    "test:db:up": "docker run -d --name colombocal-test-db -e POSTGRES_USER=postgres -e POSTGRES_PASSWORD=colombocal_dev -e POSTGRES_DB=colombocal_test -p 5433:5432 postgres:15-alpine",
    "test:db:migrate": "node scripts/test-db-migrate.js",
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:recover": "prisma migrate resolve --rolled-back 20240101000000_init_schema && prisma migrate deploy",
    "db:resolve-init-applied": "prisma migrate resolve --applied 20240101000000_init_schema",
    "db:ensure-tenant-user": "prisma db execute --file prisma/manual/ensure-tenant-user-tables.sql --schema prisma/schema.prisma",
    "db:ensure-tenant-id-columns": "prisma db execute --file prisma/manual/ensure-tenant-id-columns.sql --schema prisma/schema.prisma",
    "db:ensure-venda-legacy-columns": "prisma db execute --file prisma/manual/ensure-venda-legacy-columns.sql --schema prisma/schema.prisma",
    "db:ensure-nav-auditoria": "prisma db execute --file prisma/manual/ensure-nav-permissions-auditoria.sql --schema prisma/schema.prisma",
    "db:reset-public-schema": "node scripts/reset-public-schema.js",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:seed": "node scripts/seed.js",
    "tenant:create": "node scripts/create-tenant.js",
    "seed:deploy": "prisma migrate deploy && node scripts/seed.js",
    "db:reset": "prisma migrate reset --force",
    "legacy:reset-financeiro": "node scripts/reset-financeiro-legacy.js",
    "legacy:mdb-notes": "node scripts/legacy-mdb-notes.js",
    "legacy:plan": "python scripts/import_legacy_csv_to_new_db.py --csv-dir scripts/legacy_exports --out scripts/legacy_import_plan.json --min-date 2020-01-01",
    "legacy:import:dry": "python scripts/import_legacy_apply.py --csv-dir scripts/legacy_exports --min-date 2020-01-01",
    "legacy:import:apply": "python scripts/import_legacy_apply.py --csv-dir scripts/legacy_exports --apply --limit-sales 1000 --limit-cheques 2000 --min-date 2020-01-01"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "axios": "^1.6.7",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.80.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.4",
    "express": "^4.18.3",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "c8": "^11.0.0",
    "nodemon": "^3.1.0",
    "prisma": "^5.10.0",
    "supertest": "^7.2.2"
  }
}
