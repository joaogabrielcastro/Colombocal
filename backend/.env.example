# Backend — variáveis de ambiente
# Copie para `.env` e preencha. Nunca commite valores reais.

NODE_ENV=
PORT=
DATABASE_URL=

# Obrigatório em produção (a API recusa subir sem isso).
JWT_SECRET=
JWT_EXPIRES_IN=

# AES-256 (32 bytes em base64 OU hex de 64 chars). Obrigatório em produção.
# Gere: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FISCAL_TOKEN_ENCRYPTION_KEY=

# Somente desenvolvimento. Em produção é ignorado e o boot falha se estiver true.
AUTH_DISABLED=
DEFAULT_TENANT_ID=

# URL pública do frontend (links de redefinição de senha).
APP_PUBLIC_URL=
FRONTEND_URL=

# E-mail (recuperação de senha). Em produção use EMAIL_TRANSPORT=smtp.
EMAIL_TRANSPORT=
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
PASSWORD_RESET_ENABLED=

CORS_ORIGIN=
TRUST_PROXY=
JSON_BODY_LIMIT=

# Primeiro admin em /setup (mín. 8 caracteres).
SETUP_SECRET=

# Cadastro público em /cadastro (desligado por omissão).
OPEN_REGISTRATION=
REGISTRATION_KEY=
REGISTRATION_TENANT_SLUG=
REGISTRATION_TENANT_SLUGS=

RATE_LIMIT_MAX_PER_WINDOW=
RATE_LIMIT_CNPJ_PER_MIN=
RATE_LIMIT_SETUP_PER_HOUR=
RATE_LIMIT_REGISTER_PER_HOUR=
RATE_LIMIT_LOGIN_PER_WINDOW=
RATE_LIMIT_FORGOT_PASSWORD_PER_WINDOW=
RATE_LIMIT_RESET_PASSWORD_PER_WINDOW=

# NF-e (Focus). Token do emitente é criptografado em repouso (FISCAL_TOKEN_ENCRYPTION_KEY).
NFE_PROVIDER=
FOCUS_NFE_TOKEN=
FOCUS_NFE_AMBIENTE=
# Obrigatório para aceitar webhooks em produção. Sem valor padrão.
NFE_WEBHOOK_SECRET=
NFE_TENANT_SLUGS=

REDIS_URL=
EXPORT_QUEUE_MODE=
EXPORT_WORKER_CONCURRENCY=

RUN_PRISMA_MIGRATE_ON_START=
ALLOW_STARTUP_DB_COMPAT=
PRISMA_AUTO_RESOLVE_ROLLED_BACK_FAILED_INIT=

ADMIN_RESET_SECRET=
RESET_FINANCE_SECRET=
ENABLE_LEGACY_RESET_API=

ERROR_ALERT_WEBHOOK=

CLIENT_CPF_TENANT_SLUGS=
NO_FRETE_TENANT_SLUGS=

# Testes de integração (Postgres na 5436).
TEST_DATABASE_URL=
