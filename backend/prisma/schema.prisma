// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        Int      @id @default(autoincrement())
  name      String
  slug      String?  @unique
  createdAt DateTime @default(now())

  users           User[]
  clientes        Cliente[]
  produtos        Produto[]
  motoristas      Motorista[]
  vendedores      Vendedor[]
  vendas          Venda[]
  cheques         Cheque[]
  pagamentos      Pagamento[]
  titulos         TituloReceber[]
  fretes          FreteMovimento[]
  movimentacoes   MovimentacaoEstoque[]
  configs         ConfigSistema[]
  eventos         FinanceiroEvento[]
  comissaoAjustes ComissaoAjusteVenda[]
}

model User {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  email           String   @unique
  passwordHash    String
  name            String?
  role            String   @default("member")
  /// Chaves de menu permitidas (JSON array). null = todas as abas do papel.
  navPermissions  Json?
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Cliente {
  id                     Int      @id @default(autoincrement())
  tenantId               Int
  /// PJ = empresa (CNPJ); PF = pessoa física (CPF)
  tipoPessoa             String   @default("PJ")
  cnpj                   String?
  cpf                    String?
  razaoSocial            String
  nomeFantasia           String?
  telefone               String?
  cidade                 String?
  estado                 String?
  endereco               String?
  observacoes            String?
  fretePadrao            Decimal  @default(0) @db.Decimal(10, 2) // legado (mantido por compatibilidade)
  fretePadraoSaco        Decimal  @default(0) @db.Decimal(10, 2)
  fretePadraoTonelada    Decimal  @default(0) @db.Decimal(10, 2)
  vendedorId             Int?
  comissaoFixaPercentual Decimal? @db.Decimal(5, 2)
  ativo                  Boolean  @default(true)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  tenant          Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendedor        Vendedor?             @relation(fields: [vendedorId], references: [id])
  precosEspeciais PrecoClienteProduto[]
  comissoesProduto ComissaoClienteProduto[]
  vendas          Venda[]
  cheques         Cheque[]
  pagamentos      Pagamento[]
  titulos         TituloReceber[]
  fretes          FreteMovimento[]

  @@unique([tenantId, cnpj])
  @@unique([tenantId, cpf])
  @@index([tenantId, ativo, razaoSocial])
}

model Produto {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  nome        String
  codigo      String
  precoPadrao Decimal  @db.Decimal(10, 2)
  unidade     String   @default("ton")
  ativo       Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  precosClientes   PrecoClienteProduto[]
  comissoesClientes ComissaoClienteProduto[]
  itensVenda     ItemVenda[]
  movimentacoes  MovimentacaoEstoque[]

  @@unique([tenantId, codigo])
}

model PrecoClienteProduto {
  id        Int     @id @default(autoincrement())
  clienteId Int
  produtoId Int
  preco     Decimal @db.Decimal(10, 2)

  cliente Cliente @relation(fields: [clienteId], references: [id])
  produto Produto @relation(fields: [produtoId], references: [id])

  @@unique([clienteId, produtoId])
}

model ComissaoClienteProduto {
  id                 Int     @id @default(autoincrement())
  clienteId          Int
  produtoId          Int
  comissaoPercentual Decimal @db.Decimal(5, 2)

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)

  @@unique([clienteId, produtoId])
}

model Motorista {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  nome      String
  telefone  String?
  veiculo   String?
  placa     String?
  ativo     Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  vendas Venda[]

  @@index([tenantId])
}

model Vendedor {
  id                 Int      @id @default(autoincrement())
  tenantId           Int
  nome               String
  telefone           String?
  comissaoPercentual Decimal  @default(0) @db.Decimal(5, 2)
  ativo              Boolean  @default(true)
  createdAt          DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clientes Cliente[]
  vendas   Venda[]

  @@index([tenantId])
}

model Venda {
  id              Int      @id @default(autoincrement())
  tenantId        Int
  /// Número exibido (#) reiniciado por tenant (1, 2, 3…). O `id` continua sendo a chave técnica.
  numeroVenda     Int
  clienteId       Int
  vendedorId      Int
  motoristaId     Int?
  // Frete: fonte da verdade operacional é Venda (valor + recibo). FreteMovimento espelha o 1º movimento por venda para histórico/listagem; criado/atualizado pela API de venda (PATCH/POST).
  frete           Decimal  @default(0) @db.Decimal(10, 2)
  freteTarifaSaco Decimal  @default(0) @db.Decimal(10, 2)
  freteTarifaTonelada Decimal @default(0) @db.Decimal(10, 2)
  freteRecibo     Boolean  @default(false) // recibo de frete emitido?
  freteReciboNum  String? // número do recibo de frete
  comissaoPercentualAplicado Decimal @default(0) @db.Decimal(5, 2)
  comissaoValor              Decimal @default(0) @db.Decimal(10, 2)
  valorTotal      Decimal  @db.Decimal(10, 2) // apenas produtos, sem frete
  dataVenda       DateTime @default(now())
  observacoes     String?
  createdAt       DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente   Cliente    @relation(fields: [clienteId], references: [id])
  vendedor  Vendedor   @relation(fields: [vendedorId], references: [id])
  motorista Motorista? @relation(fields: [motoristaId], references: [id])

  itens          ItemVenda[]
  movimentacoes  MovimentacaoEstoque[]
  cheques        Cheque[]
  pagamentos     Pagamento[]
  titulos        TituloReceber[]
  fretes         FreteMovimento[]
  comissaoAjuste ComissaoAjusteVenda?

  @@unique([tenantId, numeroVenda])
  @@index([tenantId, clienteId, dataVenda])
  @@index([tenantId, vendedorId, dataVenda])
}

model ItemVenda {
  id            Int     @id @default(autoincrement())
  vendaId       Int
  produtoId     Int
  quantidade    Decimal @db.Decimal(10, 3)
  precoUnitario             Decimal @db.Decimal(10, 2)
  subtotal                  Decimal @db.Decimal(10, 2)
  comissaoPercentualAplicado Decimal @default(0) @db.Decimal(5, 2)
  comissaoValor              Decimal @default(0) @db.Decimal(10, 2)

  venda   Venda   @relation(fields: [vendaId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])
}

model MovimentacaoEstoque {
  id         Int      @id @default(autoincrement())
  tenantId   Int
  produtoId  Int
  tipo       String // entrada, saida, ajuste, devolucao
  quantidade Decimal  @db.Decimal(10, 3)
  data       DateTime @default(now())
  observacao String?
  vendaId    Int?

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  produto Produto @relation(fields: [produtoId], references: [id])
  venda   Venda?  @relation(fields: [vendaId], references: [id], onDelete: Cascade)

  @@index([tenantId, produtoId, data])
  @@index([vendaId])
}

model Cheque {
  id              Int       @id @default(autoincrement())
  tenantId        Int
  numeroOrdem     Int
  clienteId       Int
  vendaId         Int? // venda a que este cheque se refere
  valor           Decimal   @db.Decimal(10, 2)
  emitenteNome    String?
  banco           String?
  numero          String?
  agencia         String?
  conta           String?
  dataRecebimento DateTime  @default(now())
  dataCompensacao DateTime?
  status          String    @default("ativo")
  observacoes     String?
  createdAt       DateTime  @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente   Cliente    @relation(fields: [clienteId], references: [id])
  venda     Venda?     @relation(fields: [vendaId], references: [id], onDelete: SetNull)
  pagamento Pagamento?

  @@unique([tenantId, numeroOrdem])
  @@index([tenantId, clienteId, status, dataRecebimento])
  @@index([vendaId])
}

model Pagamento {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  clienteId   Int
  vendaId     Int?
  tipo        String // cheque, dinheiro, transferencia
  valor       Decimal  @db.Decimal(10, 2)
  data        DateTime @default(now())
  chequeId    Int?     @unique
  observacoes String?
  createdAt   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id])
  venda   Venda?  @relation(fields: [vendaId], references: [id], onDelete: SetNull)
  cheque  Cheque? @relation(fields: [chequeId], references: [id])

  @@index([tenantId, clienteId, data])
  @@index([vendaId, data])
}

model TituloReceber {
  id            Int      @id @default(autoincrement())
  tenantId      Int
  clienteId     Int
  vendaId       Int?
  numero        String?
  vencimento    DateTime
  valorOriginal Decimal  @db.Decimal(10, 2)
  valorPago     Decimal  @default(0) @db.Decimal(10, 2)
  status        String   @default("aberto") // aberto, parcial, quitado
  observacoes   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id])
  venda   Venda?  @relation(fields: [vendaId], references: [id], onDelete: SetNull)

  @@index([tenantId, clienteId, status, vencimento])
  @@index([vendaId])
}

// Espelho/histórico de frete (listagem / legados sem venda). Não editar valor isolado sem passar pela Venda — ver sincronização em routes/vendas.js.
model FreteMovimento {
  id            Int       @id @default(autoincrement())
  tenantId      Int
  vendaId       Int? // opcional: fretes legados sem ordem vinculada no banco novo
  clienteId     Int
  valor         Decimal   @db.Decimal(10, 2)
  reciboEmitido Boolean   @default(false)
  reciboNumero  String?
  reciboData    DateTime? // data do recibo (pode diferir da data do movimento)
  data          DateTime  @default(now())
  observacao    String?
  createdAt     DateTime  @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venda   Venda?  @relation(fields: [vendaId], references: [id], onDelete: SetNull)
  cliente Cliente @relation(fields: [clienteId], references: [id])

  @@index([tenantId, clienteId, data])
  @@index([vendaId])
}

// Parâmetros por tenant (regras comerciais/financeiras)
model ConfigSistema {
  id        Int      @id @default(autoincrement())
  tenantId  Int
  chave     String
  valor     String
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, chave])
}

model ComissaoAjusteVenda {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  vendaId     Int      @unique
  ajusteValor Decimal  @default(0) @db.Decimal(10, 2)
  motivo      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  venda  Venda  @relation(fields: [vendaId], references: [id], onDelete: Cascade)
}

/// Eventos de auditoria (append-only). Ver política de retenção em `services/financeiroEventos.js`.
model FinanceiroEvento {
  id          Int      @id @default(autoincrement())
  tenantId    Int
  userId      Int?
  userLabel   String?
  tipo        String
  entidade    String
  entidadeId  Int?
  clienteId   Int?
  vendaId     Int?
  chequeId    Int?
  pagamentoId Int?
  tituloId    Int?
  valor       Decimal? @db.Decimal(10, 2)
  payload     Json?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, tipo, createdAt])
  @@index([tenantId, clienteId, createdAt])
  @@index([tenantId, vendaId, createdAt])
  @@index([tenantId, chequeId, createdAt])
  @@index([tenantId, userId, createdAt])
}
