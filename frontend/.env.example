# Frontend — variáveis de ambiente
# Copie para `.env.local`. Nunca commite valores reais.

# Origem da API (rewrite /api → backend).
NEXT_PUBLIC_API_ORIGIN=

# Em desenvolvimento: false permite UI sem tela de login (AUTH_DISABLED no backend).
# Em produção o frontend sempre exige login; a API continua exigindo JWT.
NEXT_PUBLIC_REQUIRE_LOGIN=

# Agrupa itens avançados do menu.
NEXT_PUBLIC_UI_HIDE_ADVANCED=
